    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>01c413e1-dfed-46c6-81ef-64e632e04faa</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
